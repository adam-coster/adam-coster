{
	"dependencies": {
		"@bscotch/pathy": "2.12.1",
		"@bscotch/trebuchet": "2.9.5",
		"@types/mocha": "10.0.10",
		"@typescript-eslint/eslint-plugin": "8.19.0",
		"@typescript-eslint/parser": "8.19.0",
		"depcheck": "1.4.7",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-html": "8.1.2",
		"eslint-plugin-prettier": "5.2.1",
		"eslint-plugin-svelte3": "4.0.0",
		"prettier": "3.4.2",
		"prettier-plugin-svelte": "3.3.2",
		"svelte": "5.16.2",
		"syncpack": "13.0.0",
		"turbo": "2.3.3",
		"typescript": "5.7.2",
		"zx": "8.3.0"
	},
	"devDependencies": {
		"@types/node": "22.10.5",
		"eslint": "9.17.0",
		"eslint-scope": "8.2.0"
	},
	"engines": {
		"node": ">=18"
	},
	"name": "@adam-coster/root",
	"optionalDependencies": {
		"nodemon": "^3.1.9"
	},
	"packageManager": "pnpm@8.3.1",
	"private": true,
	"scripts": {
		"bump": "treb version && treb publish",
		"post": "node scripts/post-from-note.mjs",
		"build:all": "turbo run build",
		"build:force": "turbo run build --force",
		"ci:site": "pnpm install:site && pnpm test:site",
		"clean:artifacts": "rm -rf packages/*/dist && rm -rf packages/*/.svelte-kit",
		"clean:deps": "find . -name 'node_modules' -type d -prune -exec rm -rf {} +",
		"fix:deps": "syncpack fix-mismatches",
		"install:site": "pnpm --filter @adam-coster/site... --filter root install",
		"local:sync": "nodemon --ext toml,json,yaml,yml,mjs,js,cjs,nu --watch dotfiles --watch scripts scripts/sync-configs.mjs",
		"setup:pnpm": "corepack prepare $npm_package_packageManager --activate",
		"test": "turbo run test",
		"test:site": "turbo run build test --filter=@adam-coster/site",
		"watch": "turbo run watch --parallel"
	},
	"syncpack": {
		"workspace": false
	},
	"trebuchet": {
		"vscodeWorkspaceConfigPath": false
	},
	"type": "module",
	"version": "0.0.1",
	"workspaces": [
		"projects/*"
	]
}
