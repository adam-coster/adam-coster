{
  "name": "@adam-coster/site",
  "version": "0.39.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "svelte-kit sync && vite build && node scripts/postBuild.js",
    "bump": "cd .. && pnpm bump",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "ci:publish": "node scripts/ci.publish.js",
    "dev": "svelte-kit sync && vite dev --port 3000",
    "preview": "vite preview --port 3037",
    "prepublish": "exit 1",
    "test": "concurrently --names serve,test --success command-test --kill-others \"pnpm:preview\" \"pnpm:test:when-ready\"",
    "test:dev": "TEST_PORT=3000 playwright test --trace on",
    "test:when-ready": "wait-on --timeout 30000 http://localhost:3037 && TEST_PORT=3037 playwright test",
    "version:tag": "git tag -a $npm_package_name@$npm_package_version -m \"Version $npm_package_version\" && git push --follow-tags"
  },
  "dependencies": {
    "@adam-coster/site-tools": "workspace:*",
    "@bscotch/pathy": "2.12.1",
    "@fortawesome/free-brands-svg-icons": "6.7.2",
    "@fortawesome/free-solid-svg-icons": "6.7.2",
    "highlight.js": "11.11.1",
    "just-debounce": "1.1.0",
    "svelte": "^5.20.0",
    "svelte-fa": "4.0.3"
  },
  "devDependencies": {
    "@fortawesome/fontawesome-common-types": "6.7.2",
    "@playwright/test": "1.49.1",
    "@sveltejs/adapter-cloudflare": "5.0.1",
    "@sveltejs/kit": "^2.17.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/lunr": "2.3.7",
    "concurrently": "9.1.2",
    "dotenv": "16.4.7",
    "gray-matter": "4.0.3",
    "lunr": "2.3.9",
    "prettier": "3.4.2",
    "puppeteer": "^24.1.0",
    "schema-dts": "1.1.2",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wait-on": "8.0.2",
    "wrangler": "3.103.2",
    "zx": "8.3.0"
  }
}
