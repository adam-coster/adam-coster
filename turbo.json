{
	"$schema": "https://turborepo.org/schema.json",
	"tasks": {
		"check": {
			"cache": false
		},
		"build": {
			"dependsOn": ["^build"],
			"cache": false,
			"outputs": [
				"dist/**",
				"out/**",
				"build/**",
				"app/**",
				".netlify/**",
				".svelte-kit/**"
			]
		},
		"watch": {
			"dependsOn": ["build"],
			"outputs": [],
			"cache": false
		},
		"test": {
			"dependsOn": ["build"],
			"outputs": []
		}
	}
}
